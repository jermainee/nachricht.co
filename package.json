{
  "name": "nachricht.co",
  "version": "5.0.0",
  "description": "",
  "private": true,
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "watch": "sass --load-path=node_modules --quiet-deps --watch ./resources/scss/app.scss ./public/css/app.css",
    "scss": "sass --load-path=node_modules --quiet-deps ./resources/scss/app.scss ./public/css/app.css",
    "scss-production": "sass --load-path=node_modules --quiet-deps --style=compressed --no-source-map ./resources/scss/app.scss ./public/css/app.css",
    "js": "uglifyjs --compress ./resources/js/app.js --output ./public/js/app.js",
    "build": "npm run scss-production",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "bulma": "^1.0.4",
    "bulma-switch": "^2.0.4",
    "sass": "^1.106.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
